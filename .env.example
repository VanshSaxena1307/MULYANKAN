# ==============================================================================
# MULYANKAN - Academic Project Evaluation Platform
# Institutional Environment Configuration Template
# ==============================================================================

# Application Runtime Environment
NODE_ENV=development

# Backend Server Configuration
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
# Format: postgresql://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mulyankan

# Authentication & Security
# Generate a strong 256-bit secret for production deployment
JWT_SECRET=mulyankan-institutional-secure-secret-key-change-in-prod
JWT_EXPIRES_IN=7d

# Institution Details
INSTITUTION_NAME="ABES Engineering College"
INSTITUTION_CODE="ABES"
FACULTY_USERNAME_DOMAIN="@abes"
